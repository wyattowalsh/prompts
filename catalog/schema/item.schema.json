{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompts.w4w.dev/schema/item.schema.json",
  "$comment": "The custom keyword uniqueBy is registered by packages/catalog-core/src/json-schema.js; package-wide ownership, filename-stem, related missing/self, and reference checks remain semantic validation.",
  "title": "Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "lane",
    "blurb",
    "badge",
    "order",
    "sources",
    "evidence",
    "safety",
    "caveat",
    "modes"
  ],
  "properties": {
    "slug": { "$ref": "#/$defs/slug" },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\r\\n\\u2028\\u2029]*\\S$"
    },
    "lane": { "$ref": "#/$defs/lane" },
    "blurb": { "type": "string", "minLength": 1 },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo", "color", "chip_label"],
      "properties": {
        "logo": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "chip_label": { "type": "string", "minLength": 1 }
      }
    },
    "order": { "type": "integer", "minimum": 0 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "evidence": { "type": "string", "minLength": 1 },
    "safety": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "caveat": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "avoid_when": { "type": "string", "minLength": 1 },
    "model_api_controls": { "type": "string", "minLength": 1 },
    "cost_latency": { "type": "string", "minLength": 1 },
    "failure_modes": { "type": "string", "minLength": 1 },
    "eval_required": { "type": "boolean" },
    "related": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueBy": "id",
      "contains": {
        "type": "object",
        "required": ["default"],
        "properties": { "default": { "const": true } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/mode" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": {
        "enum": [
          "catalog",
          "explore",
          "sources",
          "recipes",
          "patterns",
          "research",
          "github"
        ]
      }
    },
    "lane": {
      "type": "string",
      "enum": [
        "research",
        "writing",
        "coding",
        "data",
        "product",
        "operations",
        "agents",
        "reasoning"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^/?#:@\\s]+(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][\\x21-\\x7E]*)?$"
        }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "example", "notes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "required": { "type": "boolean" },
        "example": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string" },
        "preview": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "required": ["example"],
            "properties": { "example": { "const": "see_preview_below" } }
          },
          "then": {
            "required": ["preview"],
            "properties": { "preview": { "type": "string", "pattern": "\\S" } }
          }
        }
      ]
    },
    "afterCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_pointer", "expected_output", "upgrade_when"],
      "properties": {
        "fill_pointer": { "type": "string", "const": "match_placeholder_table" },
        "expected_output": { "type": "string", "minLength": 1 },
        "upgrade_when": { "type": "string", "minLength": 1 }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "default", "when_to_use", "placeholders"],
      "oneOf": [
        {
          "required": ["prompt"],
          "properties": {
            "prompt": { "type": "string", "pattern": "\\S" }
          }
        },
        {
          "required": ["template_omission_reason"],
          "properties": {
            "template_omission_reason": { "type": "string", "pattern": "\\S" }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "default": { "type": "boolean" },
        "when_to_use": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "template_omission_reason": { "type": "string" },
        "placeholders": {
          "type": "array",
          "uniqueItems": true,
          "uniqueBy": "name",
          "items": { "$ref": "#/$defs/placeholder" }
        },
        "after_copy": { "$ref": "#/$defs/afterCopy" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
