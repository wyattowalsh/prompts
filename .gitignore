# Custom rules (everything added below won't be overriden by 'Generate .gitignore File' if you use 'Update' option)

# Read-only audit workspace artifacts (orchestrated review swarm scratch space)
.audit/

# Python bytecode
__pycache__/

# JavaScript dependencies and generated web artifacts
node_modules/
/public/
**/dist/
# Committed Takumi README chrome (hash-checked). Parent **/dist/ would hide T033 rasters.
!catalog/shell/chrome/dist/
!catalog/shell/chrome/dist/**
!catalog/shell/chrome/dist/*.png
!catalog/shell/chrome/dist/hashes.json
web/dist/
playwright-report/
test-results/
.vercel/
